---
/**
 * An interactive 3D model from content/models.yaml. The page ships a still poster, the controls and the parts
 * list as plain HTML; three.js and the model file are only downloaded when the reader taps "Explore in 3D"
 * (see src/scripts/model-viewer.ts).
 */
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { loadAtlas, mdInline, structureUrl, url } from '../lib/atlas';
import type { ViewerConfig } from '../scripts/model-viewer';

interface Props {
  id: string;
  /** the entry whose page this is: its parts are selected on load, and links to it are left out */
  entry: string;
}
const { id, entry } = Astro.props;
const atlas = await loadAtlas();
const m = atlas.models.get(id)!.data;
const groupColor = new Map(m.groups.map((g) => [g.name, g.color]));

const parts = await Promise.all(
  m.parts.map(async (p) => {
    const target = p.to && p.to !== entry ? atlas.byId.get(p.to) : undefined;
    return {
      id: p.id,
      node: p.node,
      label: p.label,
      group: p.group,
      color: p.color ?? groupColor.get(p.group)!,
      side: p.side,
      internal: p.internal,
      note: await mdInline(p.note),
      href: target && structureUrl(target),
      toName: target?.data.name,
    };
  }),
);
const config: ViewerConfig = {
  file: url(m.file),
  parts,
  views: m.views,
  focus: entry === m.entry ? undefined : m.parts.find((p) => p.to === entry)?.id,
};
const size = (statSync(join(process.cwd(), 'public', m.file)).size / 1e6).toFixed(1);
const LICENSE_URLS: Record<string, string> = {
  'CC BY 4.0': 'https://creativecommons.org/licenses/by/4.0/',
  CC0: 'https://creativecommons.org/publicdomain/zero/1.0/',
};
const licenseUrl = LICENSE_URLS[m.license];
---

<figure class="fig model3d" data-model={id} data-config={JSON.stringify(config)} data-alt={m.alt}>
  <div class="m3d-stage">
    {m.poster && <img class="m3d-poster" src={url(m.poster)} alt={m.alt} loading="lazy" decoding="async" />}
    <button type="button" class="btn primary m3d-load" data-load>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7z"></path><path d="m3 7 9 5 9-5M12 12v10"></path></svg>
      Explore in 3D <span class="m3d-size">{size} MB</span>
    </button>
    <p class="m3d-status small" data-status role="status"></p>
  </div>
  <div class="m3d-controls" hidden>
    <div class="diagram-tools m3d-views" role="group" aria-label="Views">
      {
        m.views.map((v, i) => (
          <button type="button" class="btn tool-btn" data-view={i}>
            {v.name}
          </button>
        ))
      }
    </div>
    <div class="diagram-tools">
      <button type="button" class="btn tool-btn" data-toggle="glass" aria-pressed="false">See-through walls</button>
      <button type="button" class="btn tool-btn" data-toggle="side" aria-pressed="false" title="Right side blue, left side red">
        Color by side
      </button>
      <button type="button" class="btn tool-btn" data-quiz aria-pressed="false">Quiz me</button>
    </div>
    <div class="m3d-info" data-info aria-live="polite">
      <p class="small muted">Drag to rotate, pinch or scroll to zoom, and tap a part to name it.</p>
    </div>
    <details class="m3d-parts" open>
      <summary>Parts</summary>
      <div class="m3d-groups">
        {
          m.groups.map((g) => (
            <fieldset>
              <legend>{g.name}</legend>
              {parts
                .filter((p) => p.group === g.name)
                .map((p) => (
                  <div class="m3d-part" data-part={p.id}>
                    <input type="checkbox" checked data-show={p.id} aria-label={`Show ${p.label}`} />
                    <button type="button" class="m3d-name" data-select={p.id} aria-pressed="false">
                      <i class="m3d-swatch" style={`background:${p.color}`} />
                      {p.label}
                    </button>
                  </div>
                ))}
            </fieldset>
          ))
        }
      </div>
    </details>
  </div>
  <figcaption>
    <strong>{m.title}.</strong>{' '}
    {m.description}
    <div class="attribution">
      3D model: {m.author}{m.work && <>, <em>{m.work}</em></>}. <a href={m.source} rel="noopener">Source</a> ·{' '}
      {licenseUrl ? <a href={licenseUrl} rel="license noopener">{m.license}</a> : m.license}
      {m.licenseNote && <> ({m.licenseNote})</>}
    </div>
  </figcaption>
</figure>

<script>
  import type { ViewerConfig } from '../scripts/model-viewer';

  for (const fig of document.querySelectorAll<HTMLElement>('figure.model3d')) {
    const btn = fig.querySelector<HTMLButtonElement>('[data-load]')!;
    const status = fig.querySelector<HTMLElement>('[data-status]')!;
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      status.textContent = 'Loading 3D viewer…';
      try {
        const { mount } = await import('../scripts/model-viewer');
        await mount(fig, JSON.parse(fig.dataset.config!) as ViewerConfig);
        status.textContent = '';
      } catch (e) {
        console.error(e);
        status.textContent =
          e instanceof Error && e.name === 'ViewerError'
            ? e.message
            : "The 3D viewer couldn't load. Check your connection and try again.";
        btn.disabled = false;
      }
    });
  }
</script>
